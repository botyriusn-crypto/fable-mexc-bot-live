export interface MexcSymbolSpec {
  priceScale: number
  qtyScale: number
  contractMultiplier: number
}

const SPECS: Record<string, MexcSymbolSpec> = {
  BTC_USDT: { priceScale: 1, qtyScale: 0, contractMultiplier: 1 },
  ETH_USDT: { priceScale: 2, qtyScale: 0, contractMultiplier: 1 },
  BANK_USDT: { priceScale: 5, qtyScale: 4, contractMultiplier: 10000 },
  ADA_USDT: { priceScale: 5, qtyScale: 0, contractMultiplier: 1 },
  RIVER_USDT: { priceScale: 4, qtyScale: 2, contractMultiplier: 1 },
}

export function getMexcSpec(symbol: string, price: number): MexcSymbolSpec {
  return SPECS[symbol] ?? { priceScale: price < 1 ? 5 : 2, qtyScale: 0, contractMultiplier: 1 }
}

export function roundMexcQuantity(symbol: string, price: number, rawQuantity: number): number {
  const spec = getMexcSpec(symbol, price)
  let qty = Math.floor(rawQuantity * Math.pow(10, spec.qtyScale)) / Math.pow(10, spec.qtyScale)
  if (qty < Math.pow(10, -spec.qtyScale)) qty = Math.pow(10, -spec.qtyScale)
  return Math.round(qty * spec.contractMultiplier)
}

export function roundMexcPrice(symbol: string, price: number): number {
  const spec = getMexcSpec(symbol, price)
  return Math.round(price * Math.pow(10, spec.priceScale)) / Math.pow(10, spec.priceScale)
}
