# ---------------------------------------------------------------------------
# fable trading bot — environment variables
# On Fly.io set these with:  fly secrets set NAME=value
# ---------------------------------------------------------------------------

# Postgres connection string for the bot's database (required).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Dashboard / API authentication (REQUIRED for a secure deployment) ------

# Password used to log into the web dashboard at /login.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign dashboard session cookies. Use a long random string.
# If unset, DASHBOARD_PASSWORD is used as the signing secret instead.
#   Generate one:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-64-char-hex-secret

# API key for programmatic access to the API (scripts / automation).
# Send it as either:  Authorization: Bearer <API_KEY>   or   x-api-key: <API_KEY>
API_KEY=change-me-to-a-long-random-api-key

# Shared password for the /api/bot/webhook endpoint (TradingView alerts, etc.).
WEBHOOK_PASSWORD=change-me-to-a-webhook-password

# --- Exchange credentials ---------------------------------------------------
# The active exchange is chosen by the in-app exchange switch (MEXC / Bybit /
# Gate.io). Provide credentials for whichever exchange(s) you trade on.

# MEXC
MEXC_API_KEY=
MEXC_API_SECRET=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Gate.io
GATEIO_API_KEY=
GATEIO_API_SECRET=

# --- AI Training Advisor (lib/ai-advisor.ts) --------------------------------
# Provider key. DeepSeek is the default; ANTHROPIC_API_KEY is accepted as a
# fallback if DEEPSEEK_API_KEY is unset.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Optional market context from cryptodataapi.com (skipped when unset).
CRYPTODATA_API_KEY=

# Hard timeout for one advisor call, ms. An unresponsive model must never
# stall the tick that requested the analysis.
AI_TIMEOUT_MS=30000

# Max tokens for the advisor response.
AI_MAX_TOKENS=1600

# Minimum closed trades for the market before the advisor will recommend.
AI_MIN_TRADES=20

# How many recent trades the advisor analyses (per symbol).
AI_TRADE_WINDOW=100

# --- Scalper thresholds (lib/trend-scalper.ts) ------------------------------
# Read at call time. The AI advisor treats these as PROPOSE-ONLY until they are
# moved into bot_config (see lib/ai-levers.ts LEVER_REGISTRY `target: "env"`).
SCALP_ENABLED=1
SCALP_ADX_MIN=18
SCALP_ADX_MAX=50
SCALP_ATRPCT_MIN=0.0015
SCALP_ATRPCT_MAX=0.10
SCALP_PULLBACK_LOOKBACK=6
SCALP_SCORE_THRESHOLD=0.5
SCALP_RISK_PCT=0.01
SCALP_R_MULTIPLE=1.8
SCALP_FLOW_WEIGHT=0
SCALP_MULTI_MARKET=0
SCALP_MAX_OPEN=3

# --- Optional risk-limit overrides (see lib/risk-manager.ts) ----------------
# MAX_DAILY_LOSS_PCT=
# MAX_DRAWDOWN_PCT=
# MAX_TOTAL_MARGIN_PCT=
# MAX_OPEN_POSITIONS=
